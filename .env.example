# Required — generate with: python3 -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=

# Image provider: "mock" | "openai_dalle" | "gemini"
IMAGE_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash-image

# TTS provider: "mock" | "gemini_tts"
# gemini_tts reuses GEMINI_API_KEY — no separate credentials needed
TTS_PROVIDER=mock
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# CORS — JSON list of allowed origins (empty = no CORS headers)
CORS_ALLOWED_ORIGINS=[]

# Server
HOST=0.0.0.0
PORT=8100
